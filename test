getgenv().FolderName = "cuteblrstuff"
getgenv().UILogo = "rbxassetid://92260093695706"

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/cryptium-lua/encrypted/refs/heads/main/lua%20ui"))()

local Window = Library:Window({ Name = "Mute Fc", SubTitle = "BLR", ExpiresIn = "N/A" })
Window:Category("Catagory")

local MainPage = Window:Page({ Name = "Central", Icon = "" })
local TestSubPage = MainPage:SubPage({ Name = "main stuff?" })

Window:Category("Settings")
local SettingsPage = Library:CreateSettingsPage(Window)

		local Players = game:GetService("Players")
		local player = Players.LocalPlayer
		local character = player.Character
		local RunService = game:GetService("RunService")

    local TestSection = TestSubPage:Section({ Name = "TouchInterest HBE", Icon = "", Side = Index })

		getgenv().TIhbe = false
		getgenv().MagDistance = 0

		local hitbox

		local function setupCharacter(character)
	    hitbox = character:WaitForChild("Hitbox")
	end

		if player.Character then
		  setupCharacter(player.Character)
	end

player.CharacterAdded:Connect(setupCharacter)

    TestSection:Toggle({
        Name = "Activate",
        Flag = "Toggle",
        Callback = function(Value)
            getgenv().TIhbe = Value
        end
    })

    TestSection:Textbox({
        Flag = "Textbox",
        Placeholder = "0",
        Default = "0",
        Finished = false,
        Numeric = true,
        Callback = function(Value)
					local num = tonumber(Value)
							if num and num > 0 then
						getgenv().MagDistance = num
					end
        end
    })

-- Touch Interest Hbe
task.spawn(function()
    RunService.Heartbeat:Connect(function()
        if not getgenv().TIhbe then return end
        if not hitbox or not hitbox.Parent then return end

        for _, value in ipairs(workspace:GetChildren()) do
            if value.Name == "Football"
            and value:IsA("BasePart")
            and value ~= hitbox then

                if (hitbox.Position - value.Hitbox.Position).Magnitude <= getgenv().MagDistance then
                    firetouchinterest(hitbox, value, 0)
                    firetouchinterest(hitbox, value, 1)
                end
            end
        end
    end)
end)