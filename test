task.spawn(function()
    while true do
        for _, football in ipairs(getgenv().FootballList) do
            if football and football.Parent and football:FindFirstChild("Hitbox") then
                local footballHitbox = football.Hitbox
                
                if getgenv().BXhbe then
                    footballHitbox.Size = Vector3.new(getgenv().BoxHitbox, getgenv().BoxHitbox, getgenv().BoxHitbox)
                else
                    footballHitbox.Size = Vector3.new(2.5, 2.5, 2.5)
                end
                
                if getgenv().TransparencyToggle then
                    footballHitbox.Transparency = getgenv().BoxTransparency
                else
                    footballHitbox.Transparency = 1
                end
            end
        end
        
        for _, diveHitbox in ipairs(getgenv().DiveList) do
            if diveHitbox and diveHitbox.Parent then
                if getgenv().DiveBXhbe then
                    diveHitbox.Size = Vector3.new(getgenv().DiveBoxHitbox, getgenv().DiveBoxHitbox, getgenv().DiveBoxHitbox)
                else
                    diveHitbox.Size = Vector3.new(2.5, 2.5, 2.5)
                end
                
                if getgenv().DiveTransparencyToggle then
                    diveHitbox.Transparency = getgenv().DiveBoxTransparency
                else
                    diveHitbox.Transparency = 1
                end
            end
        end
        
        task.wait()
    end
end)